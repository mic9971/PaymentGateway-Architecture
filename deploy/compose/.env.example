# DEVELOPMENT ONLY. Do not use real PSP/bank secrets.
POSTGRES_PASSWORD=replace-for-local-use
RABBITMQ_PASSWORD=replace-for-local-use
# Succeeded, Failed, TimeoutAfterSuccess or TimeoutBeforeEffect
MOCK_PSP_OUTCOME=Succeeded

# Development-only Mock PSP HMAC key (16+ characters). Never use this in production.
MOCK_WEBHOOK_SECRET=change-this-synthetic-local-hmac-secret

# Development mock refund: Succeeded, Failed, TimeoutAfterSuccess, TimeoutBeforeEffect
MOCK_REFUND_OUTCOME=Succeeded

# Local JWT key, 32+ UTF-8 bytes, NEVER use outside local Development.
MERCHANT_DEV_JWT_KEY=replace-with-a-new-unique-very-long-demo-key-2026
